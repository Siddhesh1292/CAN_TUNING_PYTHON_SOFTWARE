[Unit]
Description=CAN Tuner Flask App
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/can-tuner
Environment="PATH=/home/ubuntu/can-tuner/venv/bin"
Environment="FLASK_ENV=production"
ExecStart=/home/ubuntu/can-tuner/venv/bin/gunicorn \
    --bind 127.0.0.1:5000 \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    --access-logfile /var/log/can-tuner/access.log \
    --error-logfile /var/log/can-tuner/error.log \
    --log-level info \
    app:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
