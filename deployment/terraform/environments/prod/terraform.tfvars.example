# ── Production environment values ─────────────────────────────────────────────
# Copy this to terraform.tfvars and fill in your real values.
# Do NOT commit terraform.tfvars to git (it's in .gitignore).

aws_region    = "ap-south-1"
environment   = "prod"
project_name  = "can-tuner"

# Your domain (must exist as a Route 53 Hosted Zone)
domain_name   = "yourdomain.com"
app_subdomain = "tuner"          # → tuner.yourdomain.com

# EC2 sizing — t3.small is plenty for Flask + Nginx
instance_type = "t3.small"

# Name of an EC2 key pair you already created in ap-south-1
# EC2 Console → Key Pairs → Create key pair → save the .pem file
key_pair_name = "can-tuner-key"

# Restrict SSH to your IP only (recommended)
# Find your IP at https://checkip.amazonaws.com
allowed_ssh_cidrs = ["YOUR_IP/32"]

tags = {
  Project     = "CAN-Tuner"
  ManagedBy   = "Terraform"
  Environment = "prod"
  Owner       = "your-team"
}
