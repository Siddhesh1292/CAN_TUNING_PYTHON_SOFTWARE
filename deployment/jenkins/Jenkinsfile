// ── CAN Tuner — Jenkins Declarative Pipeline ──────────────────────────────────
//
// Flow:
//   git push → Jenkins builds Docker image locally
//             → saves image as .tar
//             → SCPs tar to App EC2
//             → SSHs into App EC2 → loads image → docker stop/run
//
// No ECR, no ECS, no Fargate.  Pure Docker on two EC2s.

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 20, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: true, description: 'Skip lint/test stages')
        booleanParam(name: 'DRY_RUN', defaultValue: false, description: 'Build image but do NOT deploy')
    }

    environment {
        APP_USER       = "deploy"
        APP_PORT       = "5000"
        CONTAINER_NAME = "can-tuner"
        IMAGE_NAME     = "can-tuner"
        IMAGE_LATEST   = "can-tuner:latest"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT_SHA = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG     = "${env.IMAGE_NAME}:${env.GIT_SHORT_SHA}"
                    env.TAR_FILE      = "can-tuner-${env.GIT_SHORT_SHA}.tar"
                    env.REMOTE_DIR    = "/home/deploy/images"
                }
                echo "Branch: ${env.BRANCH_NAME} | Commit: ${env.GIT_SHORT_SHA}"
            }
        }

        stage('Lint') {
            when { not { expression { params.SKIP_TESTS } } }
            steps {
                sh '''
                    flake8 app.py can_tuner3.py waveshare_can.py \
                --max-line-length=120 \
                --ignore=E501,W503,E402 \
                --statistics
                '''
            }
        }

        stage('Test') {
            when { not { expression { params.SKIP_TESTS } } }
            steps {
                sh '''
                    python3 -m pip install --quiet --break-system-packages \
                        pytest pytest-cov \
                        Flask==3.1.3 Werkzeug==3.1.8 Jinja2==3.1.6 \
                        MarkupSafe==3.0.3 itsdangerous==2.2.0 click==8.4.1 \
                        blinker==1.9.0
                    python3 -m pytest tests/ -v
                '''
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'test-results.xml'
                }
            }
        }

        stage('Build Image') {
            steps {
                sh """
                    docker build \\
                        --file deployment/docker/Dockerfile \\
                        --tag ${env.IMAGE_TAG} \\
                        --tag ${env.IMAGE_LATEST} \\
                        --label git.commit=${env.GIT_SHORT_SHA} \\
                        .
                    echo "Built: ${env.IMAGE_TAG}"
                """
            }
        }

        stage('Export Image') {
            when { not { expression { params.DRY_RUN } } }
            steps {
                sh "docker save ${env.IMAGE_LATEST} -o /tmp/${env.TAR_FILE}"
            }
        }

        stage('Deploy') {
            when { not { expression { params.DRY_RUN } } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'app-server-ssh-key', keyFileVariable: 'SSH_KEY'),
                    string(credentialsId: 'app-server-ip', variable: 'APP_IP')
                ]) {
                    sh """
                        SSH_OPTS="-o StrictHostKeyChecking=no -i \$SSH_KEY"

                        ssh \$SSH_OPTS ${env.APP_USER}@\$APP_IP "mkdir -p ${env.REMOTE_DIR}"

                        scp -o StrictHostKeyChecking=no -i \$SSH_KEY \\
                            /tmp/${env.TAR_FILE} \\
                            ${env.APP_USER}@\$APP_IP:${env.REMOTE_DIR}/

                        ssh \$SSH_OPTS ${env.APP_USER}@\$APP_IP bash << 'REMOTE'
set -e
docker load -i ${env.REMOTE_DIR}/${env.TAR_FILE}
docker stop ${env.CONTAINER_NAME} 2>/dev/null || true
docker rm   ${env.CONTAINER_NAME} 2>/dev/null || true
docker run -d \\
    --name ${env.CONTAINER_NAME} \\
    --restart unless-stopped \\
    -p ${env.APP_PORT}:${env.APP_PORT} \\
    -e FLASK_ENV=production \\
    -e PORT=${env.APP_PORT} \\
    ${env.IMAGE_LATEST}
echo "Container started"
docker ps --filter name=${env.CONTAINER_NAME}
REMOTE
                    """
                }
            }
        }

        stage('Health Check') {
            when { not { expression { params.DRY_RUN } } }
            steps {
                withCredentials([string(credentialsId: 'app-server-ip', variable: 'APP_IP')]) {
                    sh """
                        echo "Checking health..."
                        for i in 1 2 3 4 5; do
                            CODE=\$(curl -sf -o /dev/null -w "%{http_code}" http://\$APP_IP:${env.APP_PORT}/health || echo "000")
                            echo "Attempt \$i: HTTP \$CODE"
                            if [ "\$CODE" = "200" ]; then
                                echo "Health check passed!"
                                exit 0
                            fi
                            sleep 6
                        done
                        echo "Health check failed"
                        exit 1
                    """
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh "rm -f /tmp/${env.TAR_FILE} || true"
                sh "docker images ${env.IMAGE_NAME} --format '{{.ID}}' | tail -n +4 | xargs -r docker rmi -f || true"
            }
        }
    }

    post {
        success {
            echo "Deployment successful - build #${env.BUILD_NUMBER} (${env.GIT_SHORT_SHA})"
        }
        failure {
            echo "Deployment FAILED - check console output"
        }
        always {
            cleanWs()
        }
    }
}
